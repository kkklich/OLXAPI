# Real Estate API - environment
#
# Install to /etc/realestate/api.env with mode 0600:
#   install -m 600 -o realestate -g realestate realestate-api.env.example /etc/realestate/api.env
#
# systemd EnvironmentFile format: KEY=value, one per line, NO "export", NO
# quotes unless the quotes are part of the value, no inline comments.
#
# ASP.NET Core reads env vars AFTER appsettings*.json, so everything here wins
# over whatever is baked into the published JSON files. "__" replaces the ":"
# nesting separator.

ASPNETCORE_ENVIRONMENT=Production

# Port the Kestrel server binds (Program.cs reads PORT, default 5016).
# nginx proxies to this on 127.0.0.1.
PORT=5016

# --- database --------------------------------------------------------------
# Maps to ConnectionStrings:ConnectionString
#
# MySQL on the VPS (recommended - no network round-trip):
ConnectionStrings__ConnectionString=server=127.0.0.1;database=olxapi;user=olxapi;password=CHANGE_ME;
#
# MySQL still on cyberFolks shared hosting - remember to whitelist this VPS's
# IP in DirectAdmin -> MySQL Management -> Access Hosts first.
#
# Address the DB server by IP, NOT by "krzysztofklich.pl": that name has no DNS
# record at all (no A, no NS, no SOA - checked against 8.8.8.8 and 1.1.1.1), so
# MySqlConnector fails to resolve it and reports "Unable to connect to any of
# the specified MySQL hosts". 93.157.102.234 is the hosting server that answers
# on 3306 (reverse DNS www-cl-1.cyberadmin.cyber-folks.pl, MariaDB 10.11.16).
# ConnectionStrings__ConnectionString=server=93.157.102.234;database=nlddzucmzp_OLXAPI;user=nlddzucmzp_krzysztof;password=CHANGE_ME;

# Maps to Database:ServerVersion. LEAVE THIS UNSET.
# Program.cs falls back to a deliberately conservative feature set that the
# current production SQL was generated against; overriding it can change how EF
# translates queries against the live database.
# Database__ServerVersion=10.6.14-mariadb

# --- CORS ------------------------------------------------------------------
# Maps to AllowedOrigins:Frontend. Comma-separated, exact origins:
# scheme + host + optional port, NO trailing slash.
#
# Option A (frontend and API behind the same nginx): requests are same-origin,
# so this is only a safety net.
AllowedOrigins__Frontend=https://realestate.example.com
#
# Option B (frontend on cyberFolks): must list the hosting origin, or every
# browser request fails with a CORS error.
#
# The origin is scheme + host only - the /realestate/ sub-path the app is
# served from is NOT part of an Origin header, so it must not appear here.
# AllowedOrigins__Frontend=https://cf9fdf5ccf7d71a61b2548.cyberfolks.host

# --- scrape protection -----------------------------------------------------
# Guards the four scrape-trigger endpoints via the X-Api-Key header.
# An EMPTY value disables the gate entirely (see RequireScrapeApiKeyAttribute),
# which on a public server means anyone can kick off a full scrape run.
# Generate one with:  openssl rand -hex 32
ScrapeApiKey=CHANGE_ME

# --- logging ---------------------------------------------------------------
Logging__LogLevel__Default=Warning
Logging__LogLevel__Microsoft.AspNetCore=Warning
