# Angular SSR server - environment
#
# Install to /etc/realestate/web.env with mode 0600:
#   install -m 600 -o realestate -g realestate realestate-ssr.env.example /etc/realestate/web.env

NODE_ENV=production

# Port src/server.ts listens on (default 4000 when unset). nginx proxies here.
PORT=4000

# Note: server.ts calls app.listen(port) without a host argument, so Node binds
# 0.0.0.0 -- the process is reachable on the public IP at this port unless the
# firewall says otherwise. setup-vps.sh only opens 22/80/443, which is what
# keeps it private. Do not open 4000 or 5016 in ufw.
