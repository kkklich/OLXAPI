# Real Estate App - Apache config for cyberFolks shared hosting
#
# Upload into the SAME directory as index.html, i.e. public_html/realestate/
# (or public_html/ if you built with --base-href /).
#
# Only needed for the static build (Option B):
#     ng build --configuration production-static --base-href /realestate/
#
# Without this file, /realestate/properties returns an Apache 404 on reload -
# Apache looks for a directory that only the Angular router knows about.

# Stop Apache guessing extensions; it breaks extensionless route URLs.
Options -MultiViews
Options -Indexes

# ------------------------------------------------------------ SPA routing ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Must match the base href the bundle was built with.
    RewriteBase /realestate/

    # Real files and real directories are served as-is. The static build
    # pre-renders / and /properties into real HTML, so those come straight
    # off disk.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /properties/history is deliberately NOT pre-rendered: the page is addressed
    # by ?city= and ?url=, which do not exist at build time, so the only thing a
    # prerender could capture is its "missing parameter" error. Hand it the empty
    # CSR shell - index.html is the pre-rendered dashboard, and serving that here
    # paints a dashboard the router immediately tears down.
    RewriteRule ^properties/history/?$ index.csr.html [L]

    # Everything else is an Angular route: hand it index.html and let the
    # client-side router take over.
    RewriteRule ^ index.html [L]
</IfModule>

# ---------------------------------------------------------------- caching ---
<IfModule mod_headers.c>
    # index.html must never be cached, or browsers keep loading the previous
    # release's bundle references after a deploy.
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Angular content-hashes every bundle filename, so these are immutable.
    <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    Header set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                "access plus 1 year"
    ExpiresByType application/javascript  "access plus 1 year"
    ExpiresByType image/svg+xml           "access plus 1 year"
    ExpiresByType image/webp              "access plus 1 year"
    ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------- compression ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --------------------------------------------------------------- mime types ---
<IfModule mod_mime.c>
    AddType application/javascript .js .mjs
    AddType application/json       .json
    AddType image/svg+xml          .svg
    AddType font/woff2             .woff2
    # MapLibre/Leaflet vector tile and geojson payloads
    AddType application/geo+json   .geojson
</IfModule>

# ------------------------------------------------------------------- HTTPS ---
# The app calls the API over HTTPS; a page served over plain HTTP would be
# blocked as mixed content. Uncomment once the cyberFolks SSL cert is active.
#
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} !=on
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>
